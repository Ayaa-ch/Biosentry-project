# ============================================================
# BioSentry - environment configuration
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# `.env` is git-ignored: NEVER commit real credentials.
# ============================================================

# ---------- MongoDB (Atlas or local) ----------
# Used by every scraper, the NLP/normalisation scripts and all ML models.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# ---------- NCBI / PubMed (E-utilities) ----------
# Free key: https://account.ncbi.nlm.nih.gov/settings/
# With a key: 10 req/s instead of 3 req/s.
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# ---------- openFDA (FAERS adverse-event reports) ----------
# Optional free key: https://open.fda.gov/apis/key/
# Without a key the API still works, but with a lower rate limit.
OPENFDA_API_KEY=

# ---------- Neo4j (HITS source-authority score) ----------
# Local Bolt/URI connection used by collecte_des_donnees/04.Hits/hits_authority.py
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------- Elasticsearch (optional, HITS score index) ----------
ES_HOST=http://localhost:9200
ES_INDEX=biosentry_index

# ---------- Scraper identity ----------
# Contact address embedded in the MedlinePlus user-agent string.
CONTACT_EMAIL=your_email@example.com
